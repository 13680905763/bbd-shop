        "Services": [
            {
                "key": "service1",
                "title": "Passer Votre Commande",
                "describe": "Faites vos achats en toute simplicité pour n'importe quel produit de Chine, disponible en ligne et hors ligne. Pour passer commande, collez simplement le lien du produit désiré. Profitez de notre service fluide et complet qui vous guide de la navigation à l'achat en toute facilité.",
                "src": "/images/page/icon01.png"
            },
            {
                "key": "service2",
                "title": "Livraison à Notre Entrepôt",
                "describe": "Achetez auprès de divers vendeurs via notre service, et nous consolidons efficacement vos achats. Tous les articles seront expédiés vers l'entrepôt BBDbuy en Chine, rationalisant le processus pour votre commodité.",
                "src": "/images/page/icon02.png"
            },
            {
                "key": "service3",
                "title": "Processus d'Assurance Qualité",
                "describe": "Une fois vos produits arrivés à l'entrepôt BBDbuy, ils subissent un Contrôle Qualité approfondi. Notre équipe examine méticuleusement chaque article pour tout défaut, garantissant l'exactitude de la taille, de la couleur, etc. Avec BBDbuy, profitez de la tranquillité d'esprit, sachant que notre service après-vente dédié est engagé pour votre satisfaction.",
                "src": "/images/page/icon03.png"
            },
            {
                "key": "service4",
                "title": "Expédition Mondiale Simplifiée",
                "describe": "Sélectionnez des produits de votre inventaire d'entrepôt et regroupez-les facilement en un seul colis. Avec les services d'expédition mondiale fiables de BBDbuy, vos achats peuvent être livrés directement à votre porte. Profitez de la commodité d'une expédition de classe mondiale à portée de main.",
                "src": "/images/page/icon04.png"
            }
        ]
    },
